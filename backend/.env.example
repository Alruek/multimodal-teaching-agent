# ===== 复制本文件为 .env 并填入你的真实密钥 =====
# cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库。

# DeepSeek 开放平台 API Key（必填）
DEEPSEEK_API_KEY=sk-在这里填入你的DeepSeek密钥

# 可选配置
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
ALLOWED_ORIGINS=*

# 腾讯云 OCR（可选，填了才启用图片识别） 
TENCENT_SECRET_ID=在这里填入你的腾讯云SecretId
TENCENT_SECRET_KEY=在这里填入你的腾讯云SecretKey